#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC  &kp DEL    &kp C_MUTE
                &kp F13  &kp KP_NUM   &kp KP_SLASH  &kp KP_MULTIPLY  &kp KP_MINUS
                &kp F14  &kp KP_N7    &kp KP_N8     &kp KP_N9
                &kp F15  &kp KP_N4    &kp KP_N5     &kp KP_N6        &kp KP_PLUS
                &kp F16  &kp KP_N1    &kp KP_N2     &kp KP_N3
                &kp F17  &kp KP_N0    &kp KP_DOT    &kp KP_ENTER
            >;

            // Knob rotation: clockwise = volume up, counter-clockwise = volume down.
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
