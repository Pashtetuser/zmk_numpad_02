#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    // Matrix: 6 rows x 5 columns, diodes point from columns to rows
    // (diode stripe / cathode on the ROW side).
    // Pins are written as &gpioX Y = nRF52840 pin PX.Y (nice!nano and clones).
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH>   // C0: M0..M4          (P0.31, D21)
            , <&gpio0 29 GPIO_ACTIVE_HIGH>   // C1: Esc 1 4 7 Num   (P0.29, D20)
            , <&gpio0 2  GPIO_ACTIVE_HIGH>   // C2: 0 2 5 8 / Del   (P0.02, D19)
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   // C3: * 9 6 3 .       (P1.15, D18)
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   // C4: - + Enter knob  (P1.13, D15)
            ;

        row-gpios
            = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R0: knob Del Esc      (P0.17, D2)
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R1: - * / Num M0      (P0.20, D3)
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R2: 9 8 7 M1          (P0.22, D4)
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R3: + 6 5 4 M2        (P0.24, D5)
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R4: 3 2 1 M3          (P1.00, D6)
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R5: Enter . 0 M4      (P0.11, D7)
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <6>;

        // Same order as the keys in the keymap, top to bottom, left to right.
        map = <
            RC(0,1) RC(0,2) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
            RC(5,0) RC(5,2) RC(5,3) RC(5,4)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };
};
